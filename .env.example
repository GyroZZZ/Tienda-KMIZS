# URL pública del sitio.
# En Vercel no hace falta: se detecta el dominio del deployment.
# En local, déjala vacía para usar http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Mercado Pago: usar un token TEST-... en entornos de prueba.
# Este token se usa solo en funciones del servidor; nunca usar NEXT_PUBLIC_.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Resend: la dirección remitente debe estar verificada en Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# No habilitar el pago en línea hasta confirmar tarifas, plazos y municipios
# por zona con la transportadora. Ejemplos de plazo: "2 a 5".
SHIPPING_RATES_CONFIRMED=false
SHIPPING_MAIN_RATE=
SHIPPING_MAIN_ETA=
# Lista: Municipio|Departamento, Municipio|Departamento
SHIPPING_MAIN_MUNICIPALITIES=
SHIPPING_EXTENDED_RATE=
SHIPPING_EXTENDED_ETA=
SHIPPING_EXTENDED_MUNICIPALITIES=
