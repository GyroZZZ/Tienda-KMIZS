# URL pública del sitio.
# En Vercel no hace falta: se detecta el dominio del deployment.
# En local, déjala vacía para usar http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Mercado Pago: entorno de las credenciales.
# `test` (por defecto) acepta tokens TEST- y APP_USR- de la pestaña "Prueba".
# `production` solo acepta APP_USR- de la pestaña "Producción".
# Este valor se usa solo en funciones del servidor; nunca usar NEXT_PUBLIC_.
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Resend: la dirección remitente debe estar verificada en Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Buzón interno que recibe los pedidos. Admite varias direcciones separadas por coma.
# Si queda vacío, se usa el correo publicado del sitio (kmizs@protonmail.com).
ORDER_NOTIFY_EMAIL=kmizs@protonmail.com

# No habilitar el pago en línea hasta confirmar tarifas, plazos y municipios
# por zona con la transportadora. Ejemplos de plazo: "2 a 5".
SHIPPING_RATES_CONFIRMED=false
SHIPPING_MAIN_RATE=
SHIPPING_MAIN_ETA=
# Lista: Municipio|Departamento, Municipio|Departamento
SHIPPING_MAIN_MUNICIPALITIES=
SHIPPING_EXTENDED_RATE=
SHIPPING_EXTENDED_ETA=
SHIPPING_EXTENDED_MUNICIPALITIES=
